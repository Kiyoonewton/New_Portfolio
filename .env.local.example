# GitHub personal access token with "read:user" scope, used server-side only
# (never exposed to the browser) to fetch accurate contribution data.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub username to fetch contributions for
GITHUB_USERNAME=kiyoonewton

# Google Analytics 4 Measurement ID (public, safe to expose client-side)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Slack incoming webhook URL for real-time visitor notifications (server-only, never exposed)
SLACK_WEBHOOK_URL=
